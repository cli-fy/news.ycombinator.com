                          ]
                        },
                        "by": {
                          "type": "string",
                          "description": "The username of the item's author."
                        },
                        "time": {
                          "type": "integer",
                          "description": "Creation date of the item, in Unix Time."
                        },
                        "dead": {
                          "type": "boolean",
                          "description": "True if the item is dead."
                        },
                        "deleted": {
                          "type": "boolean",
                          "description": "True if the item is deleted."
                        },
                        "parent": {
                          "type": "integer",
                          "description": "The comment's parent: either another comment or the relevant story."
                        },
                        "kids": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "description": "The ids of the item's comments, in ranked display order."
                        },
                        "text": {
                          "type": "string",
                          "description": "The comment, story or poll text. HTML."
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "by",
                        "time",
                        "parent",
                        "text"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "The item's unique id."
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "job"
                          ]
                        },
                        "by": {
                          "type": "string",
                          "description": "The username of the item's author."
                        },
                        "time": {
                          "type": "integer",
                          "description": "Creation date of the item, in Unix Time."
                        },
                        "dead": {
                          "type": "boolean",
                          "description": "True if the item is dead."
                        },
                        "deleted": {
                          "type": "boolean",
                          "description": "True if the item is deleted."
                        },
                        "score": {
                          "type": "integer",
                          "description": "The story's score, or the votes for a pollopt."
                        },
                        "title": {
                          "type": "string",
                          "description": "The title of the story, poll or job. HTML."
                        },
                        "text": {
                          "type": "string",
                          "description": "The comment, story or poll text. HTML."
                        },
                        "url": {
                          "type": "string",
                          "description": "The URL of the story."
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "by",
                        "time",
                        "title"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "The item's unique id."
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "poll"
                          ]
                        },
                        "by": {
                          "type": "string",
                          "description": "The username of the item's author."
                        },
                        "time": {
                          "type": "integer",
                          "description": "Creation date of the item, in Unix Time."
                        },
                        "dead": {
                          "type": "boolean",
                          "description": "True if the item is dead."
                        },
                        "deleted": {
                          "type": "boolean",
                          "description": "True if the item is deleted."
                        },
                        "descendants": {
                          "type": "integer",
                          "description": "In the case of stories or polls, the total comment count."
                        },
                        "kids": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "description": "The ids of the item's comments, in ranked display order."
                        },
                        "parts": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "description": "A list of related pollopts, in display order."
                        },
                        "score": {
                          "type": "integer",
                          "description": "The story's score, or the votes for a pollopt."
                        },
                        "title": {
                          "type": "string",
                          "description": "The title of the story, poll or job. HTML."
                        },
                        "text": {
                          "type": "string",
                          "description": "The comment, story or poll text. HTML."
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "by",
                        "time",
                        "parts",
                        "title"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "The item's unique id."
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "pollopt"
                          ]
                        },
                        "by": {
                          "type": "string",
                          "description": "The username of the item's author."
                        },
                        "time": {
                          "type": "integer",
                          "description": "Creation date of the item, in Unix Time."
                        },
                        "dead": {
                          "type": "boolean",
                          "description": "True if the item is dead."
                        },
                        "deleted": {
                          "type": "boolean",
                          "description": "True if the item is deleted."
                        },
                        "poll": {
                          "type": "integer",
                          "description": "The poll's unique id."
                        },
                        "score": {
                          "type": "integer",
                          "description": "The story's score, or the votes for a pollopt."
                        },
                        "text": {
                          "type": "string",
                          "description": "The comment, story or poll text. HTML."
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "by",
                        "time",
                        "poll",
                        "text"
                      ]
                    }
                  ],
                  "description": "A Hacker News item (story, comment, job, poll, or pollopt)."
                }
              }
            }
          },
          "404": {
            "description": "Item not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
