    "/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search HN by relevance",
        "description": "Search Hacker News stories and comments by relevance using Algolia.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Search query string."
            },
            "required": true,
            "description": "Search query string.",
            "name": "query",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by tags (e.g., story, comment, poll, show_hn, ask_hn, author_USERNAME)."
            },
            "required": false,
            "description": "Filter by tags (e.g., story, comment, poll, show_hn, ask_hn, author_USERNAME).",
            "name": "tags",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "nullable": true,
              "minimum": 0,
              "default": 0,
              "description": "Page number (0-indexed)."
            },
            "required": false,
            "description": "Page number (0-indexed).",
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Number of hits per page."
            },
            "required": false,
            "description": "Number of hits per page.",
            "name": "hitsPerPage",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hits": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "objectID": {
                            "type": "string",
                            "description": "The item's unique id (as string)."
                          },
                          "created_at": {
                            "type": "string",
                            "description": "Creation date in ISO 8601 format."
                          },
                          "created_at_i": {
                            "type": "integer",
                            "description": "Creation date in Unix Time."
                          },
                          "author": {
                            "type": "string",
                            "description": "The username of the item's author."
                          },
                          "title": {
                            "type": "string",
                            "description": "The title of the story."
                          },
                          "text": {
                            "type": "string",
                            "description": "The text of the comment or story."
                          },
                          "url": {
                            "type": "string",
                            "description": "The URL of the story."
                          },
                          "points": {
                            "type": "integer",
                            "description": "The story's score."
                          },
                          "num_comments": {
                            "type": "integer",
                            "description": "The number of comments."
                          },
                          "children": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "description": "The ids of the item's comments."
                          },
                          "story_id": {
                            "type": "integer",
                            "description": "The story id (for comments)."
                          },
                          "_tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Tags for the item."
                          },
                          "_highlightResult": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string"
                                },
                                "matchLevel": {
                                  "type": "string",
                                  "enum": [
                                    "none",
                                    "partial",
                                    "full"
                                  ]
                                },
                                "matchedWords": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                "fullyHighlighted": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "value",
                                "matchLevel",
                                "matchedWords"
                              ]
                            }
                          }
                        },
                        "required": [
                          "objectID",
                          "created_at",
                          "created_at_i",
                          "author",
                          "_tags"
                        ]
                      },
                      "description": "List of search results."
                    },
                    "nbHits": {
                      "type": "integer",
                      "description": "Number of hits total."
                    },
                    "page": {
                      "type": "integer",
                      "description": "Current page (0-indexed)."
                    },
                    "nbPages": {
                      "type": "integer",
                      "description": "Number of pages total."
                    },
                    "hitsPerPage": {
                      "type": "integer",
                      "description": "Number of hits per page."
                    },
                    "processingTimeMS": {
                      "type": "integer",
                      "description": "Processing time in milliseconds."
                    },
                    "query": {
                      "type": "string",
                      "description": "The query string."
                    },
                    "params": {
                      "type": "string",
                      "description": "The search parameters."
                    },
                    "exhaustive": {
                      "type": "object",
                      "properties": {
                        "nbHits": {
                          "type": "boolean"
                        },
                        "typo": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "nbHits",
                        "typo"
